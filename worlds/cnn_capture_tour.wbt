DEF YELLOW_BLOCK Solid {
  translation 0.237 -0.573 0.05
  rotation 0 0 1 0.3927
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.85 0.05 roughness 1 metalness 0 }
      geometry Box { size 0.3 0.3 0.1 }
    }
  ]
  name "yellow block"
  model "yellow block"
  boundingObject Box { size 0.3 0.3 0.1 }
}

# ------------------------------------------------------------------
# The robot: e-puck with an upgraded 320x240 camera
# controllerArgs: "explore" (autonomous demo) or "tour" (capture + CNN test)
# ------------------------------------------------------------------
DEF EPUCK E-puck {
  translation 0 0 0
  rotation 0 0 1 0
  controller "epuck_vision_cnn"
  controllerArgs [
    "tour"
  ]
  supervisor TRUE
  camera_width 320
  camera_height 240
  camera_antiAliasing TRUE
  camera_rotation 0 1 0 -0.12
}
