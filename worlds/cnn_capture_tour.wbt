  }
}
DEF HORSE Horse {
  translation 0.81 0.81 0
  rotation 0 0 1 -0.7854
  scale 0.11
  name "mini horse"
}
DEF DOG Dog {
  translation 0 1.15 0
  rotation 0 0 1 0
  scale 0.32
  name "mini dog"
}
DEF SHIP PaperBoat {
  translation -0.81 0.81 0.002
  rotation 0 0 1 0.7854
  scale 0.9
  name "mini ship"
}
DEF BIRD_1 RubberDuck {
  translation -1.15 0 0.0
  rotation 0 0 1 0
  scale 1.8
  name "mini bird 1"
}
DEF BIRD_2 RubberDuck {
  translation -1.25 -0.25 0.0
  rotation 0 0 1 0.6
  scale 1.2
  bodyColor 0.95 0.95 0.95
  name "mini bird 2"
}
DEF DEER Deer {
  translation -0.81 -0.81 0
  rotation 0 0 1 0.7854
  scale 0.12
  name "mini deer"
}
DEF CAT Cat {
  translation 0 -1.15 0
  rotation 0 0 1 3.1416
  scale 0.5
  name "mini cat"
}

# ------------------------------------------------------------------
# Coloured blocks (0.3 x 0.3 x 0.1 m) on an inner ring (radius 0.62 m)
# ------------------------------------------------------------------
DEF RED_BLOCK Solid {
  translation 0.573 0.237 0.05
  rotation 0 0 1 0.3927
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.9 0.05 0.05 roughness 1 metalness 0 }
      geometry DEF BLOCK_GEOM Box { size 0.3 0.3 0.1 }
    }
  ]
  name "red block"
  model "red block"
  boundingObject USE BLOCK_GEOM
}
DEF GREEN_BLOCK Solid {
  translation -0.237 0.573 0.05
  rotation 0 0 1 0.3927
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.05 0.75 0.1 roughness 1 metalness 0 }
      geometry Box { size 0.3 0.3 0.1 }
    }
  ]
  name "green block"
  model "green block"
  boundingObject Box { size 0.3 0.3 0.1 }
}
DEF BLUE_BLOCK Solid {
  translation -0.573 -0.237 0.05
  rotation 0 0 1 0.3927
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.05 0.15 0.9 roughness 1 metalness 0 }
      geometry Box { size 0.3 0.3 0.1 }
    }
  ]
  name "blue block"
  model "blue block"
  boundingObject Box { size 0.3 0.3 0.1 }
